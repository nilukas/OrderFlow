# Copy to .env and fill in. .env is git-ignored. Never commit real secrets.
POSTGRES_PASSWORD=change-me-locally
RABBITMQ_DEFAULT_USER=orderflow
RABBITMQ_DEFAULT_PASS=change-me-locally

# Your OIDC identity provider (for example Microsoft Entra ID or Keycloak).
# The API only needs the public authority URL and the audience; it holds no secret.
OIDC_AUTHORITY=https://YOUR-OIDC-AUTHORITY/
OIDC_AUDIENCE=orderflow-orders-api

# Optional: enables the AI summary. Leave empty (and AI_ENABLED=false) to use the deterministic template.
AI_ENABLED=false
ANTHROPIC_API_KEY=
